# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# (Also stored in AWS Secrets Manager us-east-1: supabase-url / supabase-publishable-key / supabase-secret-key.)

# Browser-safe (RLS-gated) — shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# SERVER-ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never import in a Client Component.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
